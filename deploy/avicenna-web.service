[Unit]
Description=Avicenna Web (Bun static + SPA)
After=network-online.target avicenna-api.service
Wants=network-online.target avicenna-api.service

[Service]
Type=simple
WorkingDirectory=/home/dwizzy/avicenna
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=5173
Environment=API_ORIGIN=http://127.0.0.1:8899
ExecStart=%h/.bun/bin/bun web/serve.ts
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/dwizzy/avicenna

[Install]
WantedBy=default.target
